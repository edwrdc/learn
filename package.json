{
	"name": "learnharness",
	"version": "0.3.4",
	"license": "AGPL-3.0-only",
	"author": {
		"name": "Amos Blomqvist",
		"email": "255718537+amosblomqvist@users.noreply.github.com"
	},
	"homepage": "https://github.com/amosblomqvist/learnharness",
	"desktopName": "learnharness.desktop",
	"description": "An agent harness for learning: adaptive teaching, practice, and a persistent knowledge graph.",
	"type": "module",
	"private": true,
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node scripts/start-server.mjs",
		"postinstall": "node scripts/patch-pi-durable.mjs",
		"prepare": "svelte-kit sync",
		"test": "NODE_ENV=test tsx --test --test-concurrency=1 tests/*.test.ts",
		"test:browser": "node tests/browser/frontend-interactions.mjs && node tests/browser/optimistic-messages.mjs --payload dist-server/standalone",
		"lint": "eslint .",
		"typecheck": "svelte-kit sync && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
		"desktop:dev": "concurrently -k \"vite dev\" \"LH_DEV_URL=http://localhost:3000 electron .\"",
		"dev:fresh": "bash scripts/dev-fresh.sh",
		"desktop:dist": "rm -rf dist && vite build && node scripts/build-server.mjs && node scripts/smoke-provider-runtime.mjs && node scripts/smoke-server.mjs && node scripts/smoke-carrier.mjs && node scripts/smoke-server.mjs --electron && node scripts/smoke-carrier.mjs --electron && electron-builder --linux --x64 --publish never",
		"desktop:act": "act workflow_dispatch -W .act/workflows/fedora.yml -P fedora-44-x64=-self-hosted --env \"LH_OUTPUT_DIR=$PWD/dist\""
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/source-sans-3": "^5.3.1",
		"@lucide/svelte": "^1.66.0",
		"@mozilla/readability": "^0.6.0",
		"@napi-rs/canvas": "1.0.9",
		"@resvg/resvg-js": "^2.6.2",
		"clsx": "^2.1.1",
		"d3-force": "^3.0.0",
		"d3-selection": "^3.0.0",
		"d3-shape": "^3.2.0",
		"d3-zoom": "^3.0.0",
		"dagre-d3-es": "7.0.14",
		"katex": "0.18.2",
		"linkedom": "^0.18.13",
		"mdast-util-from-markdown": "2.0.3",
		"mdast-util-math": "3.0.0",
		"mermaid": "^11.17.0",
		"micromark-extension-math": "3.1.0",
		"pdfjs-dist": "^6.3.289",
		"puppeteer-core": "^25.8.0",
		"rehype-harden": "^1.1.8",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-breaks": "^4.0.0",
		"remark-cjk-friendly": "^2.3.1",
		"remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^3.19.0",
		"tailwind-merge": "^3.6.0",
		"turndown": "^7.2.4",
		"typebox": "^1.3.27",
		"unified": "^11.0.5",
		"zod": "^4.4.3"
	},
	"overrides": {
		"katex": "$katex"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^24.0.0",
		"@types/turndown": "^5.0.6",
		"@typescript-eslint/parser": "^8.68.0",
		"concurrently": "^10.0.5",
		"electron": "^44.9.3",
		"electron-builder": "26.16.1",
		"eslint": "^9.39.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"svelte-eslint-parser": "1.10.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"vite": "7.3.7"
	}
}
