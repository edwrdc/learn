{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2023",
			"dom",
			"dom.iterable"
		],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"incremental": true,
		"types": [
			"node"
		],
		"allowJs": true
	},
	"include": [
		"**/*.ts",
		"**/*.svelte"
	],
	"exclude": [
		"node_modules",
		"dist",
		"dist-server",
		"build",
		".next",
		".svelte-kit/output"
	]
}
